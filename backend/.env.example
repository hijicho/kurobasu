# Environment variables for production
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require
PORT=8080

# Supabase Auth / Storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origins allowed to call this API (comma separated)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Ads are stored in Supabase Storage.
SUPABASE_STORAGE_BUCKET=ads
SUPABASE_STORAGE_PUBLIC_BASE_URL=
