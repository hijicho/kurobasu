# Environment variables for production
DB_HOST=db.<project-ref>.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require
PORT=8080

# Supabase Auth / Storage
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend origins allowed to call this API (comma separated)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example

# Ads are stored in Supabase Storage.
SUPABASE_STORAGE_BUCKET=ads
SUPABASE_STORAGE_PUBLIC_BASE_URL=

# Base URL of the frontend app, used to build the admin timetable-import
# editor link (/admin/timetable/imports/{id}) when Google Sheets isn't
# configured (see below). Defaults to http://localhost:3000 if unset.
FRONTEND_BASE_URL=http://localhost:3000

# Optional: real Google Sheets integration for the admin timetable-import
# "edit link". If neither of these is set, the app falls back to its own
# in-app editor (FRONTEND_BASE_URL above) and everything still works.
# Set ONE of:
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON  = the service account key, as raw JSON
#   GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE  = path to the service account key file
# The service account needs the Sheets API and Drive API enabled on its
# Google Cloud project. Optionally restrict sharing to specific admins
# (comma separated emails); otherwise sheets are created as "anyone with the
# link can edit".
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SHARE_WITH=
